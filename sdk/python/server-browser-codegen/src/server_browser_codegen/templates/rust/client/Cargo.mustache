[package]
name = "server-browser-client"
version = "{{{packageVersion}}}"
edition = "2021"
description = "Generated blocking client for the Chivalry 2 community server browser API"
license = "GPL-3.0-only"
repository = "https://github.com/Chiv2-Community/C2ServerBrowserBackend"

[dependencies]
server-browser-models = { version = "={{{packageVersion}}}", path = "../server-browser-models" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
url = "2.5"
reqwest = { version = "0.12", default-features = false, features = ["json", "blocking", "multipart"] }

[features]
default = ["native-tls"]
native-tls = ["reqwest/native-tls"]
rustls-tls = ["reqwest/rustls-tls"]
