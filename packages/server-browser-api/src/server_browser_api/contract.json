  "info": {
    "title": "Server Browser API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/playfab/Client/Matchmake": {
      "post": {
        "operationId": "playfab_client_matchmake",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchmakeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayfabMatchmakeResponse"
                }
              }
            },
            "description": "Successful operation"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayfabErrorResponse"
                }
              }
            },
            "description": "No LobbyId provided"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayfabErrorResponse"
                }
              }
            },
            "description": "Lobby does not exist"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "API error; debug deployments may include an additional stack trace."
          }
        },
        "summary": "Matchmake a client to a server",
        "tags": [
          "Chiv2Compat"
        ]
      }
    },
    "/api/tbio/GetCurrentGames": {
      "post": {
        "operationId": "tbio_get_servers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TbioServerListResponse"
                }
              }
            },
            "description": "Successful operation"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "API error; debug deployments may include an additional stack trace."
          }
        },
        "summary": "Get a list of servers in Chivalry 2 format",
        "tags": [
          "Chiv2Compat"
        ]
      }
    },
    "/api/tbio/GetMotd": {
      "post": {
        "operationId": "get_motd",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MotdRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TbioMotdResponse"
                }
              }
            },
            "description": "Successful operation"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "API error; debug deployments may include an additional stack trace."
          }
        },
        "summary": "Get the Message of the Day",
        "tags": [
          "Chiv2Compat"
        ]
      }
    },
    "/api/v1/admin/ban-list": {
      "delete": {
        "operationId": "remove_from_ban_list",
        "parameters": [
          {
            "description": "The admin key",
            "in": "header",
            "name": "X-CHIV2-SERVER-BROWSER-ADMIN-KEY",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IpListRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanListResponse"
                }
              }
            },
            "description": "Successful operation"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Invalid request"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Invalid admin key"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "API error; debug deployments may include an additional stack trace."
          }
        },
        "summary": "Remove IP addresses from the ban list",
        "tags": [
          "ApiV1"
        ]
      },
      "get": {
        "operationId": "get_ban_list",
        "parameters": [
          {
            "description": "The admin key",
            "in": "header",
            "name": "X-CHIV2-SERVER-BROWSER-ADMIN-KEY",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanListResponse"
                }
              }
            },
